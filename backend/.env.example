# "development" locally; "production" on the server (also the default if unset,
# which turns on every production safety check -- see app/core/config.py).
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://zoiko:zoiko@localhost:5432/zoiko_rooms
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Leave blank for local dev (scopes the cookie to the exact host). In production,
# set to ".zoikorooms.com" so the cookie is shared across subdomains -- needed when
# frontend/backend sit on different domains, e.g. Vercel + Render.
COOKIE_DOMAIN=

SEED_ADMIN_EMAIL=admin@zoikorooms.com
SEED_ADMIN_PASSWORD=change-this-password

# Base URL this backend is reachable at -- used to build absolute URLs for uploaded images.
PUBLIC_API_URL=http://localhost:8000
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=8

# USER identity documents are stored here, never under UPLOAD_DIR -- this directory
# is never mounted as a static route.
IDENTITY_UPLOAD_DIR=secure_uploads/identity
IDENTITY_DOCUMENT_MAX_SIZE_MB=10

# Used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Chat assistant (Admin and USER). Without a real key, the assistant replies
# with a configuration error instead of failing to start.
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Stripe. Blank falls back to simulated ids everywhere (Listing Fee
# checkout/refunds and the rent-domain dispatch path).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LISTING_FEE_WEBHOOK_SECRET=
# Rent is charged on the host's own connected account, so its webhook
# (/api/finance/rental-payments/stripe/webhook) MUST be registered in Stripe as
# a Connect endpoint ("Listen to events on connected accounts") -- an ordinary
# endpoint never receives rent events. Verify or create it with:
#   python check_stripe_webhooks.py https://<your-api-host> [--create]
STRIPE_RENTAL_PAYMENT_WEBHOOK_SECRET=

# Email. "file" (default) writes emails to backend/dev_mail_outbox/ instead of
# sending them -- safe everywhere until explicitly overridden. Set to "smtp" in
# production and fill in the SMTP_* values below (works with SES, SendGrid,
# Resend, or any standard SMTP relay's SMTP interface).
EMAIL_PROVIDER=file
EMAIL_FROM=Zoiko Rooms <no-reply@zoikorooms.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Identity verification: Veriff (ZR-IDV-ADR-001) ---------------------------
# A separate Veriff integration per environment (sandbox vs production). Keep
# the key and shared secret in the secret store; rotate without code changes.
# Configure these webhook URLs on the Veriff integration (HTTPS only):
#   decision: https://<api-host>/api/v1/webhooks/veriff/decision
#   events:   https://<api-host>/api/v1/webhooks/veriff/events
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
VERIFF_BASE_URL=https://stationapi.veriff.com
VERIFF_INTEGRATION_ID=sandbox
VERIFF_RECONCILE_AFTER_MINUTES=60
# Which result webhook the Veriff plan provides: "decision" (Plus / Premium)
# or "full_auto" (Essential / self-serve).
VERIFF_PLAN=decision
# Veriff sends webhooks to PUBLIC_API_URL (set above; must be https in
# production). On localhost Veriff can't reach you: use an https tunnel, or
# rely on the automatic status check (asks Veriff's decision API) and the
# hourly reconciliation job.
# Provider written into new country packs ("veriff" once credentials are set).
IDENTITY_DEFAULT_PROVIDER=zoiko_document_check
# Built-in document check may verify on its own? Unset = only outside
# production. Never true in production (startup refuses it).
IDENTITY_BUILTIN_CHECK_CAN_VERIFY=
