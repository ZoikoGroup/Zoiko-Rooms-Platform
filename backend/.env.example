# "development" locally; "production" on the server (also the default if unset,
# which turns on every production safety check -- see app/core/config.py).
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://zoiko:zoiko@localhost:5432/zoiko_rooms
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Leave blank for local dev (scopes the cookie to the exact host). In production,
# set to ".zoikorooms.com" so the cookie is shared across subdomains -- needed when
# frontend/backend sit on different domains, e.g. Vercel + Render.
COOKIE_DOMAIN=

SEED_ADMIN_EMAIL=admin@zoikorooms.com
SEED_ADMIN_PASSWORD=change-this-password

# Base URL this backend is reachable at -- used to build absolute URLs for uploaded images.
PUBLIC_API_URL=http://localhost:8000
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=8

# USER identity documents are stored here, never under UPLOAD_DIR -- this directory
# is never mounted as a static route.
IDENTITY_UPLOAD_DIR=secure_uploads/identity
IDENTITY_DOCUMENT_MAX_SIZE_MB=10

# Used to build the link inside password-reset emails.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Chat assistant (Admin and USER). Without a real key, the assistant replies
# with a configuration error instead of failing to start.
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# Stripe. Blank falls back to simulated ids everywhere (Listing Fee
# checkout/refunds and the rent-domain dispatch path).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LISTING_FEE_WEBHOOK_SECRET=
# Rent is charged on the host's own connected account, so its webhook
# (/api/finance/rental-payments/stripe/webhook) MUST be registered in Stripe as
# a Connect endpoint ("Listen to events on connected accounts") -- an ordinary
# endpoint never receives rent events. Verify or create it with:
#   python check_stripe_webhooks.py https://<your-api-host> [--create]
STRIPE_RENTAL_PAYMENT_WEBHOOK_SECRET=

# Email. "file" (default) writes emails to backend/dev_mail_outbox/ instead of
# sending them -- safe everywhere until explicitly overridden. Set to "smtp" in
# production and fill in the SMTP_* values below (works with SES, SendGrid,
# Resend, or any standard SMTP relay's SMTP interface).
EMAIL_PROVIDER=file
EMAIL_FROM=Zoiko Rooms <no-reply@zoikorooms.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Identity verification: face match, run on this server --------------------------------
# The person uploads a photo of their identity document and takes a selfie; the server compares the two faces and, if
# they match, the identity is verified. Nothing is read from the document and the photos are never stored. Needs the
# two small face models: run `python download_face_models.py` (the Docker image and the deploy scripts do it).
# Scores are cosine similarities: >= PASS verifies, < FAIL is declined, in between asks for clearer photos.
# Calibrate on your own photos (a real selfie vs a small printed ID photo commonly scores 0.4-0.6).
FACE_MATCH_PASS=0.40
FACE_MATCH_FAIL=0.25
FACE_DETECTOR_MODEL=models/yunet.onnx
FACE_RECOGNIZER_MODEL=models/sface.onnx
IDENTITY_DEFAULT_PROVIDER=face_match

# ZR-PROPERTY-VERIFY-001 location providers (SERVER credentials -- restrict by IP/API, never expose to the browser).
# Google Maps Platform is primary (enable only Places API (New), Address Validation API, Geocoding API).
# Mapbox and HERE are optional fallbacks. With none set, hosts use manual address entry + evidence review.
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
HERE_API_KEY=
LOCATION_PROVIDER=google
LOCATION_FALLBACK_PROVIDERS=mapbox,here

# ZR-AUTHORITY-002 Section 13: optional ClamAV daemon for authority evidence uploads.
# Unset = structural file checks only (scan status NOT_SCANNED).
CLAMAV_HOST=
CLAMAV_PORT=3310

# ZR-AI-SEARCH-001 licensed listing APIs for external discovery. Keys only make
# a source callable; it is used only after its Source Rights Registry row is
# approved (ACTIVE + legal + security) and external.search_fallback is on.
# RentCast (US only, free plan 50 requests/month): https://www.rentcast.io/api
RENTCAST_API_KEY=
# Domain (Australia, free tier): https://developer.domain.com.au
DOMAIN_API_KEY=
# Brave Search (GB/US): searches ONLY approved websites (registry site_domain).
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Parallel Search (GB/US/IN): searches ONLY approved websites (registry site_domain).
# https://parallel.ai -- WEB_SEARCH_PROVIDER: parallel | tinyfish | brave (empty = first with a key)
PARALLEL_API_KEY=
# TinyFish Search (free up to 12,000 searches/day): https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=
WEB_SEARCH_PROVIDER=

# Shared secret the marketing website's server sends (X-Service-Token) when it
# calls POST /api/public/rooms/search for anonymous visitors. Set the same value
# as PLATFORM_SEARCH_SERVICE_TOKEN in the website's env. Empty = per-IP limits only.
PUBLIC_SEARCH_SERVICE_TOKEN=
